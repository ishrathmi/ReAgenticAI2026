# Copy this file to .env and fill in your own values. Never commit .env.
# Each team member uses their own OpenRouter key.
OPENROUTER_API_KEY=sk-or-v1-...

# Agreed default model, so results are comparable across the team.
# Override locally if you are experimenting.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: contact email sent to Crossref/OpenAlex in request headers ("polite pool").
CONTACT_EMAIL=
