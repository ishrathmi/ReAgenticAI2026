# Copy this file to .env (in this folder) and fill in your key. .env is gitignored; never commit it.
# Each setting can also be a system environment variable; a value in .env wins.

# Claude, through OpenRouter (https://openrouter.ai/keys). Used when set.
OPENROUTER_API_KEY=sk-or-...

# Or call Anthropic directly instead: leave OPENROUTER_API_KEY out and set this.
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAlex (paper metadata, abstracts, open-access PDFs) works without either of these.
# Set one for a higher daily limit: a free key from openalex.org, or your email address.
# OPENALEX_API_KEY=...
# OPENALEX_EMAIL=you@example.org
